// Operation ECHOLEAK - Copilot Response Review
// Reviewing Copilot's responses for suspicious external links.
// Checking for encoded filenames that may have exposed sensitive information.

CopilotAudit_CL
| where RunId == "el--17-20260920"
| where InteractionType == "Response"
| where TimeGenerated between (datetime(2026-09-20 10:42:00) .. datetime(2026-09-20 10:44:00))
| order by TimeGenerated asc
