 // Operation ECHOLEAK - Copilot Response and Potential Data Exposure
 // Purpose: Retrieve Copilot responses for examination of suspicious external URLs.
 // Data source: CopilotAudit_CL (training environment)
 // Investigation date: September 20, 2026 (UTC)
 // Note: RunId and table names are specific to this lab.
 // Evidence limitation: Response records alone do not confirm external URL requests
 // or successful transmission of document contents.

 CopilotAudit_CL
 | where RunId == "el--17-20260920"
 | where InteractionType == "Response"
 | where TimeGenerated between (datetime(2026-09-20 10:42:00) .. datetime(2026-09-20 10:44:00))
 | order by TimeGenerated asc
