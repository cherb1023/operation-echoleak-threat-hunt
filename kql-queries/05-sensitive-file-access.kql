
 // Operation ECHOLEAK - Sensitive File Access Investigation
 // Purpose: Identify files accessed during the suspicious Copilot activity.
 // Data source: OfficeActivity_CL (training environment)
 // Investigation date: September 20, 2026 (UTC)
 // Note: RunId, table names, and user identifiers are specific to this lab.

 OfficeActivity_CL
 | where RunId == "el--17-20260920"
 | where UserId == "emily.chen@cormorantcapital.com"
 | where Operation == "FileAccessed"
 | where TimeGenerated between (datetime(2026-09-20 10:42:00) .. datetime(2026-09-20 10:44:00))
 | project TimeGenerated, Operation, OfficeWorkload, OfficeObjectId
 | order by TimeGenerated asc
