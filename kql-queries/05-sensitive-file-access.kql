// Operation ECHOLEAK - Sensitive File Access
// Reviewing file access during the suspicious Copilot session.
// Checking which documents were opened and when the activity occurred.

OfficeActivity_CL
| where RunId == "el--17-20260920"
| where UserId == "emily.chen@cormorantcapital.com"
| where Operation == "FileAccessed"
| where TimeGenerated between (datetime(2026-09-20 10:42:00) .. datetime(2026-09-20 10:44:00))
| project TimeGenerated, Operation, OfficeWorkload, OfficeObjectId
| order by TimeGenerated asc
