// Operation ECHOLEAK - Copilot Activity Baseline
// Reviewing Copilot activity before the suspicious session.
// Comparing earlier interactions to see whether similar tool calls
// or searches appeared in the available history.

CopilotAudit_CL
| where RunId == "el--17-20260920"
| where TimeGenerated < datetime(2026-09-20 10:42:00)
| project TimeGenerated, UserId, InteractionType, UserPrompt, CopilotResponse, ToolName, ToolParameters
| order by TimeGenerated asc
